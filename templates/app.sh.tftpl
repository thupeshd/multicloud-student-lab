#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get -o Acquire::Retries=5 update
apt-get -o Acquire::Retries=5 install -y python3 haproxy prometheus-node-exporter curl ca-certificates gnupg
install -d -m 755 /opt/multicloud
cat >/opt/multicloud/app.py <<'PY'
import json
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path not in ('/', '/health'):
            self.send_error(404)
            return
        body = json.dumps({'cloud': '${cloud}', 'worker': sys.argv[1], 'status': 'healthy'}).encode()
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

ThreadingHTTPServer(('127.0.0.1', int(sys.argv[1])), Handler).serve_forever()
PY
cat >/etc/systemd/system/lab-app@.service <<'UNIT'
[Unit]
Description=Multi-cloud demonstration worker %i
After=network.target
[Service]
User=nobody
ExecStart=/usr/bin/python3 /opt/multicloud/app.py %i
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
UNIT
cat >/etc/haproxy/haproxy.cfg <<'HAPROXY'
global
    log /dev/log local0
    user haproxy
    group haproxy
    daemon
defaults
    mode http
    log global
    timeout connect 5s
    timeout client 30s
    timeout server 30s
frontend public_http
    bind *:80
    default_backend workers
backend workers
    balance roundrobin
    option httpchk GET /health
    http-check expect status 200
    server worker1 127.0.0.1:8081 check inter 2s fall 2 rise 2
    server worker2 127.0.0.1:8082 check inter 2s fall 2 rise 2
HAPROXY
systemctl daemon-reload
systemctl enable --now lab-app@8081 lab-app@8082 prometheus-node-exporter
haproxy -c -f /etc/haproxy/haproxy.cfg
systemctl enable haproxy
systemctl restart haproxy
